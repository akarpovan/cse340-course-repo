<%- include('partials/header') %>
    <main>
        <h1>
            <%= project.title %>
        </h1>

        <div class="project-details">

            <p class="project-description">
                <%= project.description %>
            </p>

            <p>
                <% if (user && user.role_name==='admin' ) { %>
                    <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
                    <% } %>
            </p>

            <ul class="details-list">
                <li>
                    <strong>Date:</strong>
                    <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                        day: 'numeric' , timeZone: 'UTC' }) %>
                </li>
                <li>
                    <strong>Location:</strong>
                    <%= project.location %>
                </li>
                <li>
                    <strong>Organization:</strong>
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </li>
                <li>
                    <strong>Categories:</strong>
                    <% categories.forEach(category=> { %>
                        <a href="/category/<%= category.category_id %>" class="category-tag">
                            <%= category.name %>
                        </a>
                        <% }); %>
                </li>
            </ul>

            <p>
                <% if (user && user.role_name==='admin' ) { %>
                    <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
                    <% } %>
            </p>

            <!-- ===== VOLUNTEER SECTION ===== -->
            <% if (user) { %>
                <div class="volunteer-section">
                    <% if (userIsVolunteering) { %>
                        <p class="volunteer-status">You are volunteering for this project.</p>
                        <form action="/unvolunteer/<%= project.project_id %>" method="POST">
                            <button type="submit" class="btn-danger">Remove me as a volunteer</button>
                        </form>
                        <% } else { %>
                            <form action="/volunteer/<%= project.project_id %>" method="POST">
                                <button type="submit" class="btn-primary">Add me as a volunteer for this
                                    project</button>
                            </form>
                            <% } %>
                </div>
                <% } %>
        </div>
    </main>
    <%- include('partials/footer') %>