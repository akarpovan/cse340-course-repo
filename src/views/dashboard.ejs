<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <div class="dashboard-welcome">
            <h2>Welcome back!</h2>
            <p>Name: <span>
                    <%= name %>
                </span></p>
            <p>Email: <span>
                    <%= email %>
                </span></p>
        </div>

        <div class="dashboard-actions">
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/users" class="dashboard-card admin-only">Manage Users</a>
                <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>