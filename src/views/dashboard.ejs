<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <div class="dashboard-welcome">
            <h2>Welcome back!</h2>
            <p>Name: <span>
                    <%= name %>
                </span></p>
            <p>Email: <span>
                    <%= email %>
                </span></p>
        </div>

        <div class="dashboard-actions">
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/users" class="dashboard-card admin-only">Manage Users</a>
                <% } %>
        </div>

        <!-- ===== VOLUNTEER PROJECTS SECTION ===== -->
        <h2>My Volunteer Projects</h2>

        <% if (volunteerProjects && volunteerProjects.length> 0) { %>
            <ul class="volunteer-list">
                <% volunteerProjects.forEach(project=> { %>
                    <li class="volunteer-item">
                        <div class="volunteer-info">
                            <a href="/project/<%= project.project_id %>">
                                <strong>
                                    <%= project.title %>
                                </strong>
                            </a>
                            <span class="volunteer-meta">
                                <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long'
                                    , day: 'numeric' , timeZone: 'UTC' }) %>
                                    &mdash; <%= project.location %>
                            </span>
                        </div>
                        <form action="/unvolunteer/<%= project.project_id %>" method="POST">
                            <input type="hidden" name="redirectTo" value="/dashboard">
                            <button type="submit" class="btn-danger btn-sm">Remove</button>
                        </form>
                    </li>
                    <% }) %>
            </ul>
            <% } else { %>
                <p class="no-volunteers">You have not signed up for any projects yet.
                    <a href="/projects">Browse projects</a> to get started!
                </p>
                <% } %>
    </main>

    <%- include('partials/footer') %>